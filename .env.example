# Modelo das variáveis de ambiente da API Raízes do Nordeste (D55).

# Gateway de pagamento simulado (rotas 26–28, D44)
GATEWAY_SIMULADO=true

# Banco de dados: usuário criado pelo sql/02_usuario_app.sql
DB_HOST=127.0.0.1
DB_PORTA=3306
DB_NOME=raizes_nordeste
DB_USUARIO=raizes_app
DB_SENHA=

# Segredos: um valor aleatório para cada um, gerado com
#   python3 -c "import secrets; print(secrets.token_hex(32))"
JWT_SEGREDO=
WEBHOOK_SEGREDO=
GATEWAY_CHAVE_API=

# Intervalo, em segundos, da tarefa que expira pedidos sem pagamento (D71); 0 desliga
EXPIRACAO_INTERVALO=60
